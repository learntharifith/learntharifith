// Learntharifith — Amazigh Riffian language teaching platform
// Prisma schema (SQLite)

generator client {
  provider = "prisma-client-js"
}

datasource db {
  provider = "sqlite"
  url      = env("DATABASE_URL")
}

// A single video lesson (YouTube-backed), categorized by level.
model Lesson {
  id           String   @id @default(cuid())
  title        String
  slug         String   @unique
  description  String
  youtubeId    String
  level        String   // intro | beginner | intermediate | culture
  lessonNumber Int?     // e.g. 1, 2, 3... (null for intro/culture)
  thumbnail    String
  durationMins Int      @default(0)
  order        Int      @default(0)
  featured     Boolean  @default(false)
  createdAt    DateTime @default(now())
  updatedAt    DateTime @updatedAt

  progress     UserProgress[]

  @@index([level])
  @@index([order])
}

// A culture / blog article.
model Article {
  id         String   @id @default(cuid())
  title      String
  slug       String   @unique
  excerpt    String
  content    String
  coverImage String?
  category   String   @default("Culture")
  readMins   Int      @default(5)
  published  Boolean  @default(true)
  createdAt  DateTime @default(now())
  updatedAt  DateTime @updatedAt
}

// A merch product shown in the Shop section.
model Product {
  id          String   @id @default(cuid())
  name        String
  slug        String   @unique
  description String
  price       Float
  image       String
  category    String   @default("Apparel")
  inStock     Boolean  @default(true)
  createdAt   DateTime @default(now())
  updatedAt   DateTime @updatedAt
}

// A structured online course (collection of lessons).
model Course {
  id           String   @id @default(cuid())
  title        String
  slug         String   @unique
  description  String
  level        String   @default("Beginner")
  lessonsCount Int      @default(0)
  durationHrs  Int      @default(0)
  price        Float    @default(0)
  image        String
  instructor   String   @default("Learntharifith")
  rating       Float    @default(5)
  students     Int      @default(0)
  createdAt    DateTime @default(now())
  updatedAt    DateTime @updatedAt
}

// Lightweight progress record keyed by an anonymous browser id (no auth needed).
model UserProgress {
  id        String   @id @default(cuid())
  browserId String
  lessonId  String
  completed Boolean  @default(false)
  watchedAt DateTime?
  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  lesson    Lesson   @relation(fields: [lessonId], references: [id], onDelete: Cascade)

  @@unique([browserId, lessonId])
  @@index([browserId])
}

model User {
  id        String   @id @default(cuid())
  email     String   @unique
  name      String?
  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt
}

// ── Video on demand (uploaded MP4 files) ─────────────────────────────
// isPrivate + series: private videos belong to a named series that users
// unlock with a passcode. Public videos are free for everyone.
model Video {
  id          String   @id @default(cuid())
  title       String
  description String   @default("")
  fileName    String   // original uploaded filename
  filePath    String   // relative path under /uploads
  fileSize    Int      @default(0) // bytes
  durationSec Int      @default(0)
  mimeType    String   @default("video/mp4")
  isPrivate   Boolean  @default(false)
  series      String?  // e.g. "Beginner Pack 1" — groups private videos
  order       Int      @default(0)
  createdAt   DateTime @default(now())
  updatedAt   DateTime @updatedAt

  accesses    VideoAccess[]

  @@index([isPrivate])
  @@index([series])
}

// ── User accounts (for private video access) ─────────────────────────
model UserAccount {
  id           String   @id @default(cuid())
  email        String   @unique
  username     String   @unique
  passwordHash String   // bcrypt hash
  subStatus    String   @default("pending") // pending | active | expired
  createdAt    DateTime @default(now())
  updatedAt    DateTime @updatedAt

  accesses     VideoAccess[]
  passcodes    PasscodeUse[]
}

// Links a user to a private video series they've unlocked
model VideoAccess {
  id        String   @id @default(cuid())
  userId    String
  videoId   String?
  series    String   // which series this grants access to
  createdAt DateTime @default(now())

  user      UserAccount @relation(fields: [userId], references: [id], onDelete: Cascade)
  video     Video?      @relation(fields: [videoId], references: [id], onDelete: Cascade)

  @@index([userId])
  @@index([series])
}

// Passcodes that unlock a series — generated by admin, used once by a user
model Passcode {
  id        String   @id @default(cuid())
  code      String   @unique
  series    String   // which series this unlocks
  used      Boolean  @default(false)
  usedById  String?  // UserAccount.id that used it
  createdAt DateTime @default(now())
  usedAt    DateTime?

  uses      PasscodeUse[]
}

// Records when a user redeems a passcode
model PasscodeUse {
  id          String   @id @default(cuid())
  userId      String
  passcodeId  String
  series      String
  createdAt   DateTime @default(now())

  user        UserAccount @relation(fields: [userId], references: [id], onDelete: Cascade)
  passcode    Passcode    @relation(fields: [passcodeId], references: [id], onDelete: Cascade)

  @@unique([userId, passcodeId])
}

