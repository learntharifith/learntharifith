# Copy this file to .env on the server, inside the nextapp folder.
# Path on the Contabo VPS:  /home/dev.learntharifith.com/nextapp/.env

# SQLite database location (absolute path on the server)
DATABASE_URL=file:/home/dev.learntharifith.com/nextapp/db/custom.db

# Port the Next.js standalone server listens on.
# OpenLiteSpeed will reverse-proxy to this port.
PORT=3001
HOSTNAME=127.0.0.1
NODE_ENV=production

# Author panel password — CHANGE THIS to something only you know.
# Used to log in at the "Author" link in the footer to write articles.
AUTHOR_PASSWORD=change-me-to-a-strong-password

# Admin dashboard password — for the shield icon in the footer.
# Used to upload videos, generate passcodes, and manage users.
ADMIN_PASSWORD=change-me-to-a-different-strong-password

# Secret used to sign author + admin + user session tokens (random string).
AUTHOR_SECRET=change-me-to-a-random-secret-string

# ── SMTP email config (for welcome emails to users) ──────────────────
# If not set, emails are logged to the server console instead of sent.
# Example with Gmail SMTP:
#   SMTP_HOST=smtp.gmail.com
#   SMTP_PORT=587
#   SMTP_USER=your-email@gmail.com
#   SMTP_PASS=your-app-password
#   SMTP_FROM_NAME=Learntharifith
#   SMTP_FROM_EMAIL=your-email@gmail.com
SMTP_HOST=
SMTP_PORT=587
SMTP_USER=
SMTP_PASS=
SMTP_FROM_NAME=Learntharifith
SMTP_FROM_EMAIL=no-reply@learntharifith.com

# Public site URL (used in welcome emails)
SITE_URL=https://www.learntharifith.com

# Directory where uploaded videos are stored (absolute path)
UPLOAD_DIR=/home/learntharifith.com/nextapp/uploads
